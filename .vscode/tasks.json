{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build",
        "-G",
        "Visual Studio 18 2026",
        "-A",
        "x64",
        "-DCPPWORDKIT_USE_LOCAL_DEPS=ON",
        "-DCPPWORDKIT_LOCAL_ZLIB_ROOT=${workspaceFolder}/build-msvc-deps/install",
        "-DCPPWORDKIT_LOCAL_LIBXML2_ROOT=${workspaceFolder}/build-msvc-deps/install"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "process",
      "label": "CMake: build Debug",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "使用 CMake 构建完整项目。"
    }
  ]
}
